import java.util.*;

public class HashMap {

    public static void main(String[] args) {

        HashMap<Integer, String> map = new HashMap<>();

        map.put(101, "Govind");
        map.put(102, "Rahul");
        map.put(103, "Aman");

        System.out.println(map);

        System.out.println(map.get(102));

        map.remove(101);

        System.out.println(map);
    }
}
