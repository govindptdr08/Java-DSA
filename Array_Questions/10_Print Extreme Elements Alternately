public class ExtremeElements {

    public static void main(String[] args) {

        int[] arr = {10,20,30,40,50,60};

        int left = 0;
        int right = arr.length - 1;

        while (left <= right) {

            if (left == right) {
                System.out.print(arr[left] + " ");
            } else {
                System.out.print(arr[left] + " ");
                System.out.print(arr[right] + " ");
            }

            left++;
            right--;
        }
    }
}
